# Doxygen do firmware oLoggerIOT (FW-004).
# Uso, na raiz do repositório:  doxygen Doxyfile
# Saída em build/doxygen/ (XML para o dicionário de funções e HTML para leitura).
# Opções não listadas seguem o padrão do Doxygen.

PROJECT_NAME           = "oLoggerIOT"
PROJECT_BRIEF          = "Firmware da família oLoggerIOT"
OUTPUT_LANGUAGE        = Brazilian
OUTPUT_DIRECTORY       = build/doxygen

INPUT                  = src lib include
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES
# Cabeçalhos de configuração do HAL são só definições de módulos e frequências.
EXCLUDE_PATTERNS       = */stm32*_hal_conf.h

GENERATE_XML           = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Documentação obrigatória: item sem comentário vira aviso, e aviso é erro.
EXTRACT_ALL            = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
